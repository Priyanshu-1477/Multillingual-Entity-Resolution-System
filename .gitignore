# ==========================================
# Large ML Challenge Data Files (> 50 MB)
# (Do NOT commit multi-GB raw TSVs or full candidate pairs to Git)
# ==========================================
data/
Dataset
data/raw/
data/*.tsv
Dataset/*.tsv
*.tsv
!experiments/val_*.tsv
!experiments/**/hard_negatives.tsv

# ==========================================
# Large Submission & Candidate Outputs (> 100 MB)
# ==========================================
submissions/candidate_pairs*.tsv
submissions/matching_results*.tsv
submissions/SUBMITTED/*.tsv
output/
outputs/
*.zip
*.tar.gz
*.tar

